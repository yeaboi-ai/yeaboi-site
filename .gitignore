# Worktrees live inside the checkout, in every yeaboi repo.
.claude/worktrees/

# The pinned yeaboi-tooling clone. Provisioned at Makefile parse time from
# .tooling-rev; never committed.
.tooling/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Local environment
.env

# macOS
.DS_Store

# Feature clips render here; only the spec in .demo/clips/ is committed.
.demo/out/

# This worktree's generated ports (written by the shared wt.sh).
/.worktree.env
